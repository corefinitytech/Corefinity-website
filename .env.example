# Canonical origin. Set per environment so preview deploys do not claim the
# production URL as their canonical.
NEXT_PUBLIC_SITE_URL=https://corefinity.tech

# Project brief delivery. Without both of these the form returns 503 rather
# than silently dropping a lead.
RESEND_API_KEY=
BRIEF_FROM_EMAIL=briefs@corefinity.tech
BRIEF_TO_EMAIL=hello@corefinity.tech

# Search console ownership. Omitted from the page when unset.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# IndexNow. Any 32 character hex string. Served at /<key>.txt and used to ping
# Bing and Yandex when pages change.
INDEXNOW_KEY=

# Analytics. Only loads after a visitor opts in through the cookie banner.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
