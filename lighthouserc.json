{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 4311",
      "url": [
        "http://localhost:4311/",
        "http://localhost:4311/services",
        "http://localhost:4311/services/ai-development",
        "http://localhost:4311/contact"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "color-contrast": "error",
        "is-crawlable": "error",
        "meta-description": "error",
        "canonical": "error",
        "structured-data": "off",
        "csp-xss": "warn",
        "total-byte-weight": [
          "warn",
          {
            "maxNumericValue": 600000
          }
        ],
        "unused-javascript": "warn"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
